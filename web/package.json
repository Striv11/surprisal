{
  "name": "surprisal-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm run build:wasm && vite",
    "build": "npm run build:wasm && tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types test/*.test.ts",
    "build:wasm": "cargo build --release --lib --target wasm32-unknown-unknown --manifest-path ../Cargo.toml && cp ../target/wasm32-unknown-unknown/release/surprisal.wasm public/surprisal.wasm"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "@types/node": "^22.0.0"
  }
}